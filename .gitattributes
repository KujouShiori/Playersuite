# 统一换行处理：仓库内保存 LF，检出时按平台转换
* text=auto eol=lf

# 这些文件必须以 LF 结尾，否则 Linux/macOS 上无法直接执行
gradlew text eol=lf
*.sh    text eol=lf

# 二进制文件禁止任何换行/编码转换（gradle-wrapper.jar 被改写会直接损坏）
*.jar   binary
*.png   binary
*.ico   binary

# Windows 批处理需要 CRLF
*.bat text eol=crlf

# 文本文件在 diff/统计里正常处理
*.java          text
*.json          text
*.toml          text
*.gradle        text
*.properties    text
*.md            text
*.py            text
